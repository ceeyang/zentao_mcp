# 全自动安装配置模板
# 复制为 .env.install 并填写（.env.install 已在 .gitignore，不会提交到 Git）
#
#   cp .env.install.example .env.install
#   ./auto-install.sh

# === 必填 ===
ZENTAO_URL=https://your-zentao-host
ZENTAO_ACCOUNT=your_account
ZENTAO_PASSWORD=your_password

# === 可选 ===
ZENTAO_SKIP_SSL=true

# 写操作开关（默认关闭，按需开启）
ZENTAO_ALLOW_RESOLVE_BUG=false
ZENTAO_ALLOW_CLOSE_BUG=false
ZENTAO_ALLOW_ACTIVATE_BUG=false

# 安装目标 AI 平台:
#   auto  — 自动检测本机已安装的客户端（推荐）
#   all   — 写入全部 18 个平台配置
#   cursor,claude,claude_code — 逗号分隔指定
INSTALL_PLATFORMS=auto

# 指定 node 绝对路径（GUI 客户端 PATH 不完整时可设）
# ZENTAO_NODE_PATH=/usr/local/bin/node
