# ZenTao server base URL (no trailing slash)
ZENTAO_URL=https://your-zentao-host

# Authentication: use token OR account+password
ZENTAO_TOKEN=
ZENTAO_ACCOUNT=your_account
ZENTAO_PASSWORD=your_password

# Skip TLS certificate verification for self-signed certs (optional)
ZENTAO_SKIP_SSL=false

# Write operation gates (default: disabled)
ZENTAO_ALLOW_RESOLVE_BUG=false
ZENTAO_ALLOW_CLOSE_BUG=false
ZENTAO_ALLOW_ACTIVATE_BUG=false

# Optional scope restrictions
ZENTAO_DEFAULT_PRODUCT_ID=
ZENTAO_ALLOWED_PRODUCTS=
