{
  "name": "zentao-mcp",
  "version": "0.1.3",
  "description": "禅道 Bug 追踪 MCP Server，供 Cursor / Claude 等 AI 助手读取与回写 Bug",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zentao-mcp": "bin/zentao-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceeyang/zentao_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ceeyang/zentao_mcp/issues"
  },
  "homepage": "https://github.com/ceeyang/zentao_mcp#readme",
  "files": [
    "dist",
    "bin",
    "docs",
    "repo.config.json",
    "scripts/install.mjs",
    "scripts/install-lib.mjs",
    "scripts/github-source.mjs",
    "scripts/verify-github.mjs",
    "scripts/e2e-install-test.sh",
    "scripts/smoke-test.mjs",
    "install.sh",
    "install.ps1",
    "install.cmd",
    "auto-install.sh",
    "auto-install.ps1",
    "mcp.json.example",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack:release": "npm run build && mkdir -p release && npm pack --pack-destination release",
    "smoke": "node scripts/smoke-test.mjs",
    "install:mcp": "node scripts/install.mjs",
    "install:urls": "node scripts/github-source.mjs",
    "test:install": "bash scripts/e2e-install-test.sh",
    "verify:github": "node scripts/verify-github.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "zentao",
    "chandao",
    "bug-tracking",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
